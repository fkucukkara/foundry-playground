    <script src="_framework/blazor.web.js"></script>
    <script>
        window.scrollToBottom = (id) => {
            const el = document.getElementById(id);
            if (el) el.scrollTop = el.scrollHeight;
        };
        window.focusElement = (el) => { if (el) el.focus(); };
    </script>
